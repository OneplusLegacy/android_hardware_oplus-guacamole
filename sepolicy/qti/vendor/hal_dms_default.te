#
# Dolby MultiStream (DMS) HAL 2.0 server domain for the OnePlus 7 Pro.
#
# The 7 Pro ships vendor.dolby_v3_6.hardware.dms360@2.0, not the
# vendor.dolby.hardware.dms@2.0 that the 13T port uses, but the domain layout is
# the same: one server domain, one hwservice type, and the audio effect host as
# the only client.
#
# The 13T policy also granted binder_call to platform_app, because ColorOS ships
# a com.dolby.daxservice app in that domain. The 7 Pro dump has no such APK -
# the only Dolby components are the ODM HAL, libdlbdsservice and the DAP effects
# - so that rule is dropped instead of copied. DolbyControl in this tree is a
# privileged app, which is the priv_app domain, and it talks to the effect
# through audioserver rather than to the DMS service directly.
#

type hal_dms_default, domain;
hal_server_domain(hal_dms_default, hal_dms)

type hal_dms_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_dms_default)

# Persistent DAP parameter cache. Created by the init fragment in
# vendor/oneplus/dolby-guacamole/configs/init/dolby.rc.
#
# The directory gets its own type rather than the generic vendor_data_file that
# stock OxygenOS happens to inherit from /data/vendor(.+). vendor_data_file is
# shared by every vendor component on the device, so labelling the Dolby cache
# with it would let any vendor domain that holds a generic grant read and
# rewrite dax-extra.xml and the parameter database. A dedicated type keeps the
# cache reachable only from this domain, which is what renoir and nabu do for
# the same two files.
type dolby_dms_data_file, data_file_type, file_type;

allow hal_dms_default dolby_dms_data_file:dir create_dir_perms;
allow hal_dms_default dolby_dms_data_file:file create_file_perms;

# The cache is data, never code.
neverallow hal_dms_default dolby_dms_data_file:file { execute execute_no_trans };

# The effect host and the mediaserver decode path are the clients that call in.
binder_call(hal_dms_default, hal_audio_default)
binder_call(hal_dms_default, mediacodec)

set_prop(hal_dms_default, vendor_audio_prop)
